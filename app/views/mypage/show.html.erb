<div class="mypage-show-page">
  <div class="mypage-container">

    <header class="mypage-header">
      <div class="mypage-header-text">
        <p class="mypage-eyebrow">MY TRAVEL BOOK</p>
        <h1>マイページ</h1>
        <p class="mypage-user-text">
          <%= current_user.email %>さんの旅行記録
        </p>
      </div>

      <div class="mypage-header-action">
        <%= link_to "＋ 新しい旅行を投稿する",
                    new_tweet_path,
                    class: "mypage-new-button" %>
      </div>
    </header>


    <section class="mypage-section my-travel-section">
      <div class="section-heading">
        <div>
          <p class="mypage-subtitle">MY TRAVEL RECORDS</p>
          <h2>自分の旅行記録</h2>
        </div>

        <span class="travel-count">
          <%= @tweets.count %> TRIPS
        </span>
      </div>


      <div class="tweet-list">
        <% @tweets.each do |tweet| %>
          <article class="tweet-card">

            <%= link_to tweet_path(tweet),
                        class: "tweet-card-link" do %>

              <div class="thumbnail-area">

                <% if tweet.thumbnail.attached? %>
                  <%= image_tag tweet.thumbnail,
                                class: "tweet-thumbnail",
                                alt: "#{tweet.title}のサムネイル画像" %>
                <% else %>
                  <div class="no-thumbnail">
                    <span>NO IMAGE</span>
                  </div>
                <% end %>

                <div class="thumbnail-overlay">
                  <div class="thumbnail-overlay-content">

                    <h2><%= tweet.title %></h2>

                    <p>
                      <%= tweet.s_date.strftime("%Y年%m月%d日") %>
                      ～
                      <%= tweet.f_date.strftime("%Y年%m月%d日") %>
                    </p>

                  </div>
                </div>

              </div>
            <% end %>


            <div class="tweet-card-body">

              <% if tweet.about.present? %>
                <p class="tweet-memo">
                  <%= truncate(tweet.about, length: 80) %>
                </p>
              <% end %>

              <%= link_to "しおりを見る",
                          tweet_path(tweet),
                          class: "button secondary-button" %>

            </div>

          </article>
        <% end %>


        <% if @tweets.empty? %>
          <div class="empty-message">
            <div class="empty-icon">✈</div>
            <h3>まだ旅行の記録がありません</h3>
            <p>
              最初の旅行を記録して、<br>
              あなただけの旅のしおりを作ってみましょう。
            </p>

            <%= link_to "最初の旅行を投稿する",
                        new_tweet_path,
                        class: "empty-button" %>
          </div>
        <% end %>
      </div>
    </section>


    <section class="mypage-section shared-trips">

      <div class="section-heading">
        <div>
          <p class="mypage-subtitle">SHARED TRAVEL RECORDS</p>
          <h2>共同編集中の旅行</h2>
        </div>

        <span class="travel-count">
          <%= @shared_tweets.count %> TRIPS
        </span>
      </div>


      <div class="tweet-list">

        <% @shared_tweets.each do |tweet| %>

          <article class="tweet-card shared-tweet-card">

            <%= link_to tweet_path(tweet),
                        class: "tweet-card-link" do %>

              <div class="thumbnail-area">

                <% if tweet.thumbnail.attached? %>
                  <%= cl_image_tag tweet.thumbnail.key,
                                   width: 700,
                                   height: 450,
                                   crop: :fill,
                                   gravity: :auto,
                                   fetch_format: :auto,
                                   quality: :auto,
                                   class: "tweet-thumbnail" %>
                <% else %>
                  <div class="no-thumbnail">
                    <span>NO IMAGE</span>
                  </div>
                <% end %>


                <span class="shared-badge">
                  共同編集中
                </span>


                <div class="thumbnail-overlay">
                  <div class="thumbnail-overlay-content">

                    <h2><%= tweet.title %></h2>

                    <p>
                      <%= tweet.s_date.strftime("%Y.%m.%d") %>
                      ～
                      <%= tweet.f_date.strftime("%Y.%m.%d") %>
                    </p>

                  </div>
                </div>

              </div>

            <% end %>


            <div class="tweet-card-body">

              <p class="owner-text">
                <span>OWNER</span>
                <%= tweet.user.email %>
              </p>

              <%= link_to "しおりを編集する",
                          tweet_path(tweet),
                          class: "button" %>

            </div>

          </article>

        <% end %>


        <% if @shared_tweets.empty? %>

          <div class="empty-message shared-empty">
            <div class="empty-icon">✦</div>

            <h3>共同編集中の旅行はありません</h3>

            <p>
              誰かと一緒に旅行の計画を作ると、<br>
              ここに表示されます。
            </p>
          </div>

        <% end %>

      </div>

    </section>

  </div>
</div>