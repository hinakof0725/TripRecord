<% if schedule.errors.any? %>
  <div class="error-messages">
    <ul>
      <% schedule.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: [tweet, travel_day, schedule] do |f| %>
    <div class="field schedule-image-field">
        <%= f.label :image, "思い出の画像" %>

        <% if schedule.image.attached? %>
            <div class="current-schedule-image">
            <p>現在の画像</p>

            <%= cl_image_tag schedule.image.key,
                            width: 600,
                            height: 400,
                            crop: :fill,
                            gravity: :auto,
                            fetch_format: :auto,
                            quality: :auto,
                            class: "schedule-image-preview" %>
            </div>
        <% end %>

        <%= f.file_field :image,
                        accept: "image/jpeg,image/png,image/webp" %>

        <p class="image-help">
            画像は選択しなくても投稿できます。
        </p>
    </div>

    <div class="field">
        <%= f.label :start_time, "開始時間" %>
        <%= f.time_field :start_time %>
    </div>

    <div class="field">
        <%= f.label :end_time, "終了時間" %>
        <%= f.time_field :end_time %>
    </div>

    <div class="field">
        <%= f.label :place, "場所" %>
        <%= f.text_field :place, placeholder: "清水寺" %>
    </div>

    <div class="field">
        <%= f.label :activity, "何をするか" %>
        <%= f.text_field :activity, placeholder: "清水寺を観光する" %>
    </div>

    <div class="field">
        <%= f.label :memo, "詳しいメモ" %>
        <%= f.text_area :memo,
                        rows: 5,
                        placeholder: "着物をレンタルして写真を撮る" %>
    </div>

    <%= f.submit "保存する", class: "button" %>
<% end %>