<% if tweet.errors.any? %>
  <div class="error-messages">
    <h2>入力内容を確認してください</h2>

    <ul>
      <% tweet.errors.full_messages.each do |message| %>
        <li><%= message %></li>
      <% end %>
    </ul>
  </div>
<% end %>

<%= form_with model: tweet do |f| %>

    <div class="field image-field">
        <%= f.label :thumbnail, "旅行のサムネイル画像" %>

        <% if tweet.thumbnail.attached? %>
            <div class="current-image">
            <p>現在の画像</p>

            <%= cl_image_tag tweet.thumbnail.key,
                            width: 600,
                            height: 400,
                            crop: :fill,
                            gravity: :auto,
                            fetch_format: :auto,
                            quality: :auto,
                            class: "thumbnail-preview" %>
            </div>
    <% end %>

    <%= f.file_field :thumbnail,
                    accept: "image/jpeg,image/png,image/webp" %>

        <p class="image-help">
            JPEG・PNG・WebP、10MB以下。画像は未選択でも投稿できます。
        </p>
    </div>

  <div class="field">
    <%= f.label :title, "旅行タイトル" %>
    <%= f.text_field :title, placeholder: "京都2泊3日旅行" %>
  </div>

  <div class="field">
    <%= f.label :s_date, "旅行開始日" %>
    <%= f.date_field :s_date %>
  </div>

  <div class="field">
    <%= f.label :f_date, "旅行終了日" %>
    <%= f.date_field :f_date %>
  </div>

  <div class="field">
    <%= f.label :about, "旅行全体のメモ" %>
    <%= f.text_area :about, rows: 5 %>
  </div>

  <%= f.submit "保存する", class: "button" %>
<% end %>